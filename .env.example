# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development        # set to "production" on the server
PORT=5001                    # port the server listens on
SECRET_KEY=change-me         # used by Flask sessions; generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ── Data storage ──────────────────────────────────────────────────────────────
# Override to a persistent volume path on cloud hosts (e.g. /var/data on Render)
DATA_DIR=./backend/data

# ── Infor M3 / ION API (live integration — leave blank for Dry Run mode) ──────
M3_ION_BASE_URL=             # e.g. https://mingle-ionapi.inforcloudsuite.com
M3_TENANT_ID=                # e.g. HOMECENTER_PRD
M3_CLIENT_ID=
M3_CLIENT_SECRET=
M3_CONO=100
M3_DIVI=HC
M3_VAT_CODE=6

# ── Email integration (leave blank to disable) ────────────────────────────────
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=993
EMAIL_FOLDER=INBOX
